{
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "myapp_dev",
    "url": "postgresql://localhost:5432/myapp_dev",
    "pool_size": 5
  },
  "api": {
    "key": "dev-api-key-12345",
    "base_url": "https://api-dev.example.com",
    "timeout": 30,
    "max_retries": 3,
    "health_endpoint": "/api/health",
    "auth": {
      "type": "bearer",
      "token": "dev-bearer-token-12345"
    },
    "headers": {
      "X-Environment": "dev",
      "X-Version": "1.0.0"
    }
  },
  "cache": {
    "redis_url": "redis://localhost:6379/0",
    "ttl": 3600,
    "enabled": true
  },
  "features": {
    "enable_debug": true,
    "enable_logging": true,
    "enable_metrics": false,
    "max_connections": 100
  },
  "security": {
    "secret_key": "dev-secret-key-very-long-and-secure",
    "jwt_expiry": 86400,
    "cors_origins": ["http://localhost:3000", "http://localhost:8080"]
  },
  "logging": {
    "level": "DEBUG",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "/var/log/myapp/dev.log",
    "log_dir": "logs",
    "log_file": "dev_app.log",
    "error_log_file": "dev_error.log",
    "date_format": "%Y-%m-%d %H:%M:%S",
    "max_size": 10,
    "backup_count": 5,
    "console_enabled": true,
    "file_enabled": true,
    "error_file_enabled": true
  },
  "environment": "development",
  "debug": true,
  "version": "1.0.0-dev"
}